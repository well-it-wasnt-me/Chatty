{
  "name": "terminal-messenger",
  "version": "0.1.0",
  "private": false,
  "description": "All your conversations. One terminal. No browser circus.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "build:binary": "pnpm build && npx --yes @yao-pkg/pkg dist/index.js --targets node22-linux-x64 --output dist/chatty-linux-x64",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "baileys": "7.0.0-rc14",
    "ink": "^5.2.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "eslint": "^10.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "chatty": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
