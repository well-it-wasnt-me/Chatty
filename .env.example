# Keep credentials out of source control.

# real (default): real platform adapters; accounts without credentials
# surface setup prompts or readable errors in the UI — nothing is simulated.
# demo: five simulated accounts, nothing is sent anywhere (opt-in).
CHATTY_MODE=real

# --- Adapters ---------------------------------------------------------------
# Real transports are the default in real mode. The CHATTY_*_IMPL vars pin a
# single platform to 'demo' (or back to its real transport) without changing
# the global mode.

# SimpleX: real adapter backed by the official simplex-chat CLI as a local
# chat server (requires the binary on PATH or an absolute path).
#CHATTY_SIMPLEX_IMPL=cli
#CHATTY_SIMPLEX_BIN=simplex-chat
#CHATTY_SIMPLEX_PORT=5225
#CHATTY_SIMPLEX_DISPLAY_NAME=chatty user

# Telegram: real adapter via GramJS (user account, QR or 2FA login). Needs an
# app credential from https://my.telegram.org/apps — keep it out of the repo:
#CHATTY_TELEGRAM_IMPL=gramjs
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

# Slack: real adapter via the official Web API + Socket Mode. User token via
# env or the auth overlay (masked). App token enables realtime events.
#CHATTY_SLACK_IMPL=socket
#SLACK_USER_TOKEN=
#SLACK_APP_TOKEN=

# WhatsApp: real adapter via Baileys (QR pairing in the auth overlay).
# Applies to BOTH WhatsApp accounts — each keeps its own socket, session and
# auth directory (data/whatsapp-a vs data/whatsapp-b).
#CHATTY_WHATSAPP_IMPL=baileys

# Preview the pairing UX in demo mode (simulated QR + 2FA):
#CHATTY_DEMO_AUTH=whatsapp-a

# Root directory for per-account credentials, the SQLite cache (chatty.db)
# and persisted UI prefs. Every account gets an isolated subdirectory
# (dataDir/<account id>) so the two WhatsApp accounts can never share auth
# state. Created with mode 0700.
CHATTY_DATA_DIR=./data

# Structured diagnostics. Message contents, QR codes, tokens and session
# keys must never be logged; the file is created with mode 0600.
CHATTY_LOG_LEVEL=info
#CHATTY_LOG_FILE=./data/chatty.log

# Force the ASCII/no-color theme (also auto-detected for TERM=dumb and
# NO_COLOR).
#CHATTY_ASCII=1

# Per-adapter credentials (tokens, API ids, phone numbers) will be added
# here as the real integrations land (see docs/ADAPTERS.md).
